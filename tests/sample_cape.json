          {"api": "RegSetValue", "timestamp": 3, "arguments": {"regkey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"}},
          {"api": "CreateScheduledTask", "timestamp": 4, "arguments": {"name": "UpdaterTask"}}
        ]
      }
    ]
  }
